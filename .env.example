# Local development environment. Copy this file to `.env.local` and fill in real
# values. `.env.local` is git-ignored; this example is safe to commit.

# MongoDB connection string.
# Local dev (what you're running now):
MONGODB_URI=mongodb://localhost:27017/careerflow
# Production later: swap for your MongoDB Atlas connection string, e.g.
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/careerflow

# Secret used to sign session JWTs (HS256). REQUIRED for login/registration.
# Generate a strong value with:  openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-string

# --- LLM provider (job-post auto-fill) ---
# Default: Groq — a free, fast, hosted API. Get a key (no credit card) at:
#   https://console.groq.com/keys
# If the model below ever 404s, pick a current one from console.groq.com/docs/models.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Alternative: run fully local & private via Ollama (no key, uses your Mac).
# To use it: set LLM_PROVIDER=ollama and `ollama pull qwen2.5:3b`.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b

# --- Gmail connection (Google OAuth) ---
# From the OAuth client you created in Google Cloud Console (application type:
# Web app). Both values are secrets — keep them only in .env.local (git-ignored).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" on that OAuth client EXACTLY.
# Local dev default below; in production set it to your deployed URL, e.g.
#   https://your-app.vercel.app/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Added in later stages, not needed yet ---

# Google Gemini API key (email classification + drafting).
# GEMINI_API_KEY=

# Shared secret the scheduled job sends to POST /api/internal/run-cycle.
# CRON_SECRET=
